# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URL.
# If omitted or offline, JanSetu AI runs seamlessly on in-memory relational store.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jansetu_ai"

# GOOGLE_MAPS_API_KEY: Optional Google Maps Platform key for full satellite/vector GIS map.
# If omitted, JanSetu AI uses interactive built-in SVG GIS map with exact stored coordinates.
GOOGLE_MAPS_API_KEY=""

# GOOGLE_CLOUD_PROJECT: Google Cloud Project ID for Cloud Run / Speech-to-Text.
GOOGLE_CLOUD_PROJECT=""

# DEMO_MODE: Enable synthetic demonstration dataset mode (Default: true)
DEMO_MODE="true"

# PORT: Server listening port (Default: 3000)
PORT="3000"
